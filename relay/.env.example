# Lighter endpoint: start on testnet, switch to https://mainnet.zklighter.elliot.ai when ready
LIGHTER_URL=https://testnet.zklighter.elliot.ai
# Your Lighter account index and the API key you registered for HookLine (never commit real values)
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=3
LIGHTER_API_PRIVATE_KEY=
# Shared secret the game sends as "Authorization: Bearer ..."; anyone holding it can trade this account
HOOKLINE_RELAY_TOKEN=
# Origins allowed to call the relay (comma separated), e.g. the page that hosts the game
ALLOWED_ORIGINS=*
# Safety rails enforced server-side, whatever the game asks for
MAX_MARGIN_USD=50
MAX_LEVERAGE=20
ALLOWED_MARKETS=BTC,ETH,SOL,HYPE,DOGE,1000PEPE,WIF
MAX_SLIPPAGE=0.01
# Optional integrator fee (HookLine's cut), in Lighter's fee units; 0 = off
INTEGRATOR_ACCOUNT_INDEX=0
INTEGRATOR_TAKER_FEE=0
